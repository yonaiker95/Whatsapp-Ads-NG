DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_ads?schema=public

# Auth
SESSION_SECRET=cambiar-en-produccion
APP_URL=http://localhost:4200

# Evolution API
EVOLUTION_API_URL=http://localhost:3100
EVOLUTION_API_KEY=evolution_api_7465829274

# n8n
N8N_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=admin@whatsapp-ads.com
N8N_BASIC_AUTH_PASSWORD=Admin123
# API key de n8n (X-N8N-API-KEY) usada por la app para aprovisionar los
# workflows por instancia. Se crea en n8n: Settings > Public API > Create API Key.
N8N_API_KEY=
# URL que los workflows de n8n usan para llamar de vuelta a la app
# (generación de respuestas con el AI Center). Dentro del contenedor n8n,
# host.docker.internal apunta al host donde corre la app.
N8N_APP_URL=http://host.docker.internal:3000
# URL que los workflows de n8n usan para enviar mensajes a Evolution
# (dentro del contenedor n8n, "evolution_api:8080" es el contenedor Evolution).
N8N_EVOLUTION_URL=http://evolution_api:8080

# Chatbot
GEMINI_API_KEY=

# Centro de IA (API keys de proveedores IA). Si AI_ENC_KEY no está definida,
# se usa SESSION_SECRET como clave maestra de cifrado.
AI_ENC_KEY=cambiar-en-produccion-clave-maestra-ia

# Server
PORT=3000
# API_TARGET=http://localhost:3000   <- si la API corre en otro dominio/puerto
# API_PORT=3000                      <- puerto de la API para el proxy de desarrollo
